# Publish only reviewed source and documentation paths.
/*
!/.gitignore
!/README.md
!/package.json
!/docs/
/docs/*
!/docs/INSTALL.md
!/docs/SOURCES.md
!/docs/UPSTREAM.md
!/docs/RENDER_INPUT.md
!/docs/roster.svg
!/docs/hd-seated-sleep.png
!/host/
/host/*
!/host/upstream.json
!/host/encoding.json
!/scripts/
/scripts/*
!/scripts/*.mjs
!/scripts/package_clawd.py
!/scripts/build_release.py
!/scripts/preview_server.py
!/tests/
/tests/*
!/tests/*.test.mjs
!/web/
/web/*
!/web/*.mjs
!/web/*.js
!/web/*.html
!/web/*.css
!/web/*.json
!/vendor/
/vendor/*
!/vendor/three/
/vendor/three/*
!/vendor/three/three.module.js
!/vendor/three/LICENSE

# Local-only material, even inside an allowed directory.
**/__pycache__/
**/node_modules/
**/.env
**/.env.*
**/*.log
**/*.pem
**/*.key
**/*.bak
**/*~
